server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  resolver ${DNS_RESOLVER} valid=10s ipv6=off;
  set $backend_api ${BACKEND_URL};

  location /api/ {
    proxy_pass $backend_api;
    proxy_ssl_server_name on;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
