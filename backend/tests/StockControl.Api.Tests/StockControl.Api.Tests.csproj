<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutput>$(MSBuildProjectDirectory)/../../TestResults/coverage/</CoverletOutput>
    <CoverletOutputFormat>cobertura,json</CoverletOutputFormat>
    <Include>[StockControl.Api]*</Include>
    <!-- Las decisiones están en Domain, StockService y MappingExtensions; los controllers son adaptadores. -->
    <Exclude>[StockControl.Api]Program*,[StockControl.Api]StockControl.Api.Data.*,[StockControl.Api]StockControl.Api.Services.StockRepository*,[StockControl.Api]StockControl.Api.Controllers.*</Exclude>
    <ExcludeByFile>**/Models/Product.cs,**/Models/Supplier.cs,**/Models/StockMovement.cs,**/Models/Dtos.cs</ExcludeByFile>
    <IncludeTestAssembly>false</IncludeTestAssembly>
    <Threshold>80</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" PrivateAssets="all" />
    <ProjectReference Include="../../StockControl.Api.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Conservar el reporte de Coverlet cuando VSTest falla, sin ocultar el error.
       Se extiende el punto de entrada del SDK .NET 8 después de importar sus targets. -->
  <Target Name="VSTest" DependsOnTargets="ShowInfoMessageIfProjectHasNoIsTestProjectProperty">
    <CallTarget Targets="_VSTestConsole"
                Condition="!$(VsTestUseMSBuildOutput) OR $(MSBUILDENSURESTDOUTFORTASKPROCESSES) == '1'" />
    <CallTarget Targets="_VSTestMSBuild" Condition="$(VsTestUseMSBuildOutput)" />
    <OnError ExecuteTargets="GenerateCoverageResult" Condition="'$(CollectCoverage)' == 'true'" />
  </Target>
</Project>
